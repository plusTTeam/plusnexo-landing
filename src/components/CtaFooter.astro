---
const year = new Date().getFullYear();
---

<section
  id="cta"
  class="relative flex min-h-screen flex-col items-center justify-center px-6 text-center"
>
  <p class="font-heading text-xs uppercase tracking-[0.15em] text-fg-muted">
    ¿Hablamos?
  </p>
  <h2
    class="mx-auto mt-4 max-w-xl font-heading text-3xl font-bold leading-tight text-fg md:text-5xl"
  >
    Empecemos cuando quieras.
  </h2>

  <a
    href="mailto:plusnexo@plusteam.tech"
    class="mt-10 inline-flex items-center gap-2 rounded-lg bg-accent px-7 py-3.5 font-heading text-sm font-semibold text-bg shadow-[0_0_40px_rgba(255,122,69,0.35)] transition-shadow hover:shadow-[0_0_56px_rgba(255,122,69,0.5)]"
  >
    Escribinos a plusnexo@plusteam.tech
  </a>
</section>

<footer
  class="relative flex flex-col items-center gap-4 border-t border-border px-6 py-10 text-sm text-fg-muted md:flex-row md:justify-between md:px-16"
>
  <div class="font-heading text-base font-semibold text-fg">
    <span class="text-accent">+</span>Nexo
  </div>
  <p>© {year} +Nexo. Todos los derechos reservados.</p>
</footer>
