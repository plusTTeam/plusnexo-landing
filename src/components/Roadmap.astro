---
const roadmap = [
  {
    titulo: "Hablale por WhatsApp o Instagram",
    texto:
      "Los mismos canales que ya usás con tus clientes, conectados directo a tu negocio.",
  },
  {
    titulo: "Gestión vía MCP",
    texto:
      "Conectá +Nexo a las herramientas de IA que ya usás, con el protocolo abierto que adoptan los agentes.",
  },
  {
    titulo: "Permisos claros",
    texto:
      "Cada persona ve y hace solo lo que le corresponde — sin compartir contraseñas ni excel de accesos.",
  },
  {
    titulo: "Agentes que ejecutan tareas de proyecto",
    texto: "No solo te contestan: toman una tarea y la resuelven.",
  },
];
---

<section
  id="roadmap"
  class="relative flex min-h-screen items-center px-6 py-24 md:px-16"
>
  <div class="mx-auto max-w-3xl">
    <p class="font-heading text-xs uppercase tracking-[0.15em] text-fg-muted">
      Próximamente
    </p>
    <h2
      class="mt-4 font-heading text-3xl font-bold leading-tight text-fg md:text-5xl"
    >
      Esto es solo el comienzo.
    </h2>

    <div class="mt-16 flex flex-col">
      {
        roadmap.map((item, index) => (
          <div class="roadmap-item flex gap-6 border-t border-border py-8 first:border-t-0 first:pt-0">
            <span class="shrink-0 font-mono text-sm text-accent">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-heading text-lg font-semibold text-fg md:text-xl">
                {item.titulo}
              </h3>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-fg-muted">
                {item.texto}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
