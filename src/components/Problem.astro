---
const dolores = [
  {
    numero: "01",
    titulo: "Cargás el mismo dato dos veces.",
    texto:
      "Facturación no ve lo que vendió el equipo comercial. Alguien tiene que volver a tipearlo a mano, en una planilla aparte.",
  },
  {
    numero: "02",
    titulo: "Todo está, pero nada se encuentra.",
    texto:
      "Diez pestañas, cinco menús, y todavía no sabés en qué módulo se factura un pedido.",
  },
  {
    numero: "03",
    titulo: "Necesitás un consultor para lo básico.",
    texto:
      "Configurar algo tan simple como un impuesto nuevo termina siendo un ticket de soporte.",
  },
];
---

<section
  id="problema"
  class="relative flex min-h-screen items-center px-6 py-24 md:px-16"
>
  <div class="mx-auto max-w-3xl">
    <p class="font-heading text-xs uppercase tracking-[0.15em] text-fg-muted">
      El problema
    </p>
    <h2
      class="mt-4 font-heading text-3xl font-bold leading-tight text-fg md:text-5xl"
    >
      Un ERP tradicional te hace trabajar para él.
    </h2>

    <div class="mt-16 flex flex-col gap-12">
      {
        dolores.map((dolor) => (
          <div class="problem-card flex gap-6 border-t border-border pt-8">
            <span class="shrink-0 font-mono text-sm text-fg-muted">
              {dolor.numero}
            </span>
            <div>
              <h3 class="font-heading text-xl font-semibold text-fg md:text-2xl">
                {dolor.titulo}
              </h3>
              <p class="mt-3 max-w-xl text-base leading-relaxed text-fg-muted">
                {dolor.texto}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
