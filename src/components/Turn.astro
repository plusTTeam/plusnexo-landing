---

---

<section
  id="giro"
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center"
>
  <p class="font-heading text-xs uppercase tracking-[0.15em] text-fg-muted">
    El giro
  </p>

  <div class="turn-old mx-auto mt-10 flex max-w-md flex-col items-center gap-4">
    <div class="grid grid-cols-4 gap-2 opacity-40">
      {
        Array.from({ length: 12 }).map(() => (
          <span class="h-3 w-8 rounded-sm bg-fg-muted" />
        ))
      }
    </div>
    <p class="font-heading text-xl text-fg-muted md:text-2xl">
      Dejá de llenar formularios.
    </p>
  </div>

  <div class="turn-new mx-auto mt-10 flex max-w-md flex-col items-center gap-4">
    <svg
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="#ff7a45"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 20l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
      ></path>
    </svg>
    <p class="font-heading text-2xl font-semibold text-fg md:text-3xl">
      Empezá a hablar.
    </p>
  </div>
</section>
