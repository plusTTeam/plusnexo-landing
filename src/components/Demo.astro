---
const campos = [
  { label: "Cliente", valor: "Constructora del Sur" },
  { label: "Concepto", valor: "Instalación eléctrica" },
];
---

<section
  id="demo"
  class="relative flex min-h-screen items-center overflow-hidden px-6 py-24 md:px-16"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    style="background-image: radial-gradient(circle, rgba(245,245,247,0.05) 1px, transparent 1px); background-size: 28px 28px;"
  >
  </div>

  <div
    class="relative mx-auto flex max-w-5xl flex-col items-center gap-6 md:flex-row md:items-center md:justify-between md:gap-12"
  >
    <div class="demo-chat w-full max-w-md">
      <div
        class="flex items-center gap-2 font-heading text-xs uppercase tracking-[0.15em] text-fg-muted"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 20l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
          ></path>
        </svg>
        Chat
      </div>
      <div
        class="mt-3 rounded-2xl border border-border bg-bg-raised px-6 py-5 text-lg leading-relaxed text-fg"
      >
        Facturá $500 a Constructora del Sur por la obra de instalación
        eléctrica.
      </div>
    </div>

    <div
      class="demo-arrow hidden shrink-0 font-heading text-sm italic text-fg-muted md:block"
    >
      se convierte en →
    </div>
    <div class="demo-arrow font-heading text-sm italic text-fg-muted md:hidden">
      ↓ se convierte en
    </div>

    <div
      class="demo-card w-full max-w-md rounded-2xl border border-[rgba(255,122,69,0.35)] bg-bg-raised px-7 py-6 shadow-[0_0_60px_rgba(255,122,69,0.08)]"
    >
      <p
        class="font-heading text-[11px] uppercase tracking-[0.1em] text-fg-muted"
      >
        Registro generado
      </p>
      <p class="mt-1 font-heading text-2xl font-semibold text-fg">
        Factura #0001
      </p>

      <div class="mt-5 flex flex-col gap-3.5">
        {
          campos.map((campo) => (
            <div class="demo-row flex items-baseline justify-between border-b border-border pb-3.5">
              <span class="text-sm text-fg-muted">{campo.label}</span>
              <span class="font-mono text-sm text-fg">{campo.valor}</span>
            </div>
          ))
        }
        <div
          class="demo-row flex items-baseline justify-between border-b border-border pb-3.5"
        >
          <span class="text-sm text-fg-muted">Total</span>
          <span class="font-mono text-xl font-semibold text-accent"
            >$500.00</span
          >
        </div>
        <div class="demo-row flex items-center justify-between">
          <span class="text-sm text-fg-muted">Estado</span>
          <span
            class="rounded-full bg-accent-soft/40 px-3.5 py-1 font-mono text-xs text-accent"
            >Emitida</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
