---
const canales = [
  {
    nombre: "Chat",
    icono:
      "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 20l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z",
  },
  {
    nombre: "WhatsApp",
    icono: "M3 21l1.6-4.7A8.5 8.5 0 1 1 8 19L3 21zM8.5 9.5c0 3.5 2.5 6 6 6",
  },
  {
    nombre: "Instagram",
    icono:
      "M4 4h16v16H4zM12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM16.5 7.5h.01",
  },
];
---

<section
  id="fuente-de-la-verdad"
  class="relative flex min-h-screen items-center px-6 py-24 md:px-16"
>
  <div class="mx-auto max-w-4xl">
    <p class="font-heading text-xs uppercase tracking-[0.15em] text-fg-muted">
      Fuente de la verdad
    </p>
    <h2
      class="mt-4 max-w-2xl font-heading text-3xl font-bold leading-tight text-fg md:text-5xl"
    >
      Sea cual sea el canal, el dato es uno solo.
    </h2>

    <div
      class="mt-16 flex flex-col items-center gap-6 md:flex-row md:items-center md:justify-between md:gap-10"
    >
      <div class="flex w-full flex-row gap-4 md:w-auto md:flex-col">
        {
          canales.map((canal) => (
            <div class="channel-card flex flex-1 items-center gap-3 rounded-xl border border-border bg-bg-raised px-5 py-4 md:flex-none">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-fg-muted"
              >
                <path d={canal.icono} />
              </svg>
              <span class="font-heading text-sm text-fg">{canal.nombre}</span>
            </div>
          ))
        }
      </div>

      <div
        class="truth-arrow font-heading text-sm italic text-fg-muted md:hidden"
      >
        ↓ convergen en
      </div>
      <div
        class="truth-arrow hidden shrink-0 font-heading text-sm italic text-fg-muted md:block"
      >
        convergen en →
      </div>

      <div
        class="truth-card w-full max-w-sm rounded-2xl border border-[rgba(255,122,69,0.35)] bg-bg-raised px-7 py-8 text-center shadow-[0_0_60px_rgba(255,122,69,0.08)]"
      >
        <p class="font-heading text-xl font-semibold text-accent">
          Datos estructurados
        </p>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          Una sola fuente de la verdad para todo tu negocio, sin importar desde
          dónde escribiste.
        </p>
      </div>
    </div>
  </div>
</section>
